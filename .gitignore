# macOS
.DS_Store

# Xcode — per-user state (schemes, breakpoints, window positions)
xcuserdata/
*.xcuserstate
*.moved-aside

# Xcode — build artifacts (regenerated on every build)
build/
DerivedData/
*.hmap
*.ipa
*.dSYM
*.dSYM.zip

# Swift Package Manager local state
.swiftpm/
.build/

# Secrets — API keys, never commit
Secrets.swift
GoogleService-Info.plist
# APNs auth key (.p8) — Apple lets you download it ONCE; store it safely, never commit
*.p8
AuthKey_*.p8
