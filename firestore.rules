rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    // Is there a signed-in user at all?
    function isSignedIn() {
      return request.auth != null;
    }

    // The signed-in user's uid.
    function uid() {
      return request.auth.uid;
    }

    // The set of field names that changed between the old doc and the new doc.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Is the signed-in user one of the two members of this couple? Reads the
    // parent couple doc, so it costs one document read per evaluated write —
    // acceptable for v1. Used to scope the swipes/matches subcollections.
    function isCoupleMember(coupleId) {
      return isSignedIn()
             && uid() in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
    }

    // ---------- users/{userId} ----------
    // A user's private profile/state. Owner-only, full stop.
    match /users/{userId} {
      allow read, write: if isSignedIn() && uid() == userId;
    }

    // ---------- invites/{token} ----------
    // The doc ID is an unguessable token. Two actors touch it:
    //   * the creator (full control of their own invite)
    //   * a redeemer (any other signed-in user who knows the token)
    match /invites/{token} {

      // CREATE: only the signed-in user can create an invite, and only one
      // stamped with themselves as creator, starting life as a fresh,
      // unconsumed invite. This stops anyone forging an invite "from" someone
      // else or pre-marking it consumed.
      allow create: if isSignedIn()
                    && request.resource.data.creatorId == uid()
                    && request.resource.data.status == 'pending'
                    && request.resource.data.consumedBy == null;

      // READ: the creator can always read their invite. Any other signed-in
      // user may read it too — they have to in order to redeem it. Security
      // here rests on the token being unguessable (it's the doc ID), not on
      // hiding the doc. No public/unauthenticated reads.
      allow read: if isSignedIn();

      // DELETE: only the creator can tear down their own invite (e.g. revoke).
      allow delete: if isSignedIn() && resource.data.creatorId == uid();

      // UPDATE (redeem): a *different* signed-in user consumes a still-pending
      // invite. Enforced invariants:
      //   - the invite is currently pending (can't re-consume)             ← one-shot
      //   - the redeemer is not the creator (can't pair with yourself)
      //   - the new status is exactly 'consumed'
      //   - consumedBy is stamped with the redeemer's own uid (no spoofing)
      //   - ONLY status + consumedBy may change; creatorId/createdAt/token
      //     and everything else stay frozen.
      allow update: if isSignedIn()
                    && resource.data.status == 'pending'
                    && resource.data.creatorId != uid()
                    && request.resource.data.status == 'consumed'
                    && request.resource.data.consumedBy == uid()
                    && request.resource.data.creatorId == resource.data.creatorId
                    && changedKeys().hasOnly(['status', 'consumedBy']);
    }

    // ---------- couples/{coupleId} ----------
    // Links exactly two users. `members` is a 2-element list of their uids.
    match /couples/{coupleId} {

      // READ: only the two people in `members` can see the couple doc.
      allow read: if isSignedIn() && uid() in resource.data.members;

      // CREATE: the creator must be one of the two members, and the doc must
      // name exactly two distinct members. This lets a redeemer establish the
      // couple at redemption time without being able to forge a couple they
      // aren't part of, or pad it with extra members.
      allow create: if isSignedIn()
                    && request.resource.data.members.size() == 2
                    && uid() in request.resource.data.members;

      // UPDATE: only an existing member may write, and the membership list is
      // frozen — you can update couple state, but you can't add/remove/swap
      // who's in the relationship.
      //
      // PRE-LAUNCH HARDENING: this permits a member to write ANY non-members
      // field, including the subscription flag (isPremium / subscriptionOwner) —
      // so a member could grant the couple premium without actually paying. Same
      // trusted-partner posture as matches/missions/memories, accepted for v1.
      // The clean end-state is a RevenueCat webhook -> Cloud Function (Admin SDK)
      // as the ONLY writer of the subscription fields, with these rules rejecting
      // client writes to them. See SubscriptionService for the matching note.
      allow update: if isSignedIn()
                    && uid() in resource.data.members
                    && request.resource.data.members == resource.data.members;

      // DELETE: not allowed from the client. Leave couples to be torn down by
      // a trusted server/admin path if ever needed.
      allow delete: if false;
    }

    // ---------- couples/{coupleId}/swipes/{cardId} ----------
    // Shared like record for two-player matching. Only RIGHT-swipes are stored;
    // `likedBy` holds the uids who liked this card. Both members present => match.
    // Scoped to the couple's two members, and a member may only add THEIR OWN uid
    // to likedBy — they can't stamp the partner or remove an existing like.
    match /couples/{coupleId}/swipes/{cardId} {
      allow read: if isCoupleMember(coupleId);

      // CREATE: the first liker writes a doc whose likedBy is exactly [self].
      allow create: if isCoupleMember(coupleId)
                    && request.resource.data.likedBy.hasOnly([uid()])
                    && request.resource.data.likedBy.hasAll([uid()]);

      // UPDATE: the second liker may only ADD self — no removals (hasAll(old)),
      // no foreign additions (hasOnly(old + self)), and self must end up present.
      allow update: if isCoupleMember(coupleId)
                    && request.resource.data.likedBy.hasAll(resource.data.likedBy)
                    && request.resource.data.likedBy.hasOnly(resource.data.likedBy.concat([uid()]))
                    && request.resource.data.likedBy.hasAll([uid()]);

      allow delete: if false;
    }

    // ---------- couples/{coupleId}/matches/{cardId} ----------
    // Created when both members have liked a card. id-only (cardId + deck); the
    // client rebuilds the card from local sample data. Immutable once made.
    //
    // PRE-LAUNCH HARDENING: a member could in principle create a match doc whose
    // pair isn't truly mutual (the rules don't cross-check the swipes doc here).
    // Trusted-partner risk, accepted for v1; the clean end-state is to create
    // matches only from a Cloud Function that verifies both likes — same
    // trajectory as the invite-redemption and venue-cache hardening notes.
    match /couples/{coupleId}/matches/{cardId} {
      allow read:   if isCoupleMember(coupleId);
      allow create: if isCoupleMember(coupleId);
      allow update, delete: if false;
    }

    // ---------- couples/{coupleId}/missions/{cardId} ----------
    // The shared, syncable planning state for a matched date (status, scheduled
    // date, budget, checklist). Doc id == cardId so both partners' apps write the
    // same document — that's what makes a date/time edit on one phone reach the
    // other. Either member may create OR update it (planning is collaborative;
    // last write wins for v1). Scoped to the couple's two members.
    //
    // PRE-LAUNCH HARDENING: same trust posture as matches — a member could write
    // arbitrary fields here. Field-shape validation (and, if ever needed, a
    // server-authored write path) is deferred, consistent with the matches /
    // invite-redemption / venue-cache notes above.
    match /couples/{coupleId}/missions/{cardId} {
      allow read:           if isCoupleMember(coupleId);
      allow create, update: if isCoupleMember(coupleId);
      allow delete:         if false;
    }

    // ---------- couples/{coupleId}/memories/{memoryId} ----------
    // The shared Memory Vault metadata: the proof-photo's Storage path plus
    // title/emoji/date/rating/note. Doc id == the memory's UUID. The photo BYTES
    // live in Cloud Storage (see storage.rules), never here. Either member may
    // create/update (the couple shares one vault). Scoped to the two members.
    //
    // PRE-LAUNCH HARDENING: same trust posture as missions/matches — a member
    // could write arbitrary fields. Field-shape validation (and a server-
    // authored write path, if ever needed) is deferred, consistent with the
    // notes above and with storage.rules' couple-membership note.
    match /couples/{coupleId}/memories/{memoryId} {
      allow read:           if isCoupleMember(coupleId);
      allow create, update: if isCoupleMember(coupleId);
      allow delete:         if false;
    }

    // ---------- venues/{placeId} ----------
    // Cached Google Places data, keyed by the resolved place.id. Venues aren't
    // private, so reads are open to everyone (even unauthenticated). Writes are
    // allowed for any signed-in user for v1.
    //
    // PRE-LAUNCH HARDENING: "any signed-in user can write" means a logged-in
    // client could poison the cache (write a bad doc under a real placeId). The
    // clean end-state is `allow write: if false` here and do all cache writes
    // from a Cloud Function (Admin SDK bypasses rules) — same trajectory as the
    // invite redemption hardening note. Accepted for v1.
    match /venues/{placeId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ---------- venueQueries/{queryKey} ----------
    // Pointer cache: a normalized free-text query + location bucket -> placeId,
    // so repeat lookups skip the billed Text Search. Same posture as venues:
    // world-readable, signed-in writes for v1, Cloud-Function-only later.
    match /venueQueries/{queryKey} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ---------- events/{eventId} ----------
    // Cached Ticketmaster events, keyed by the Ticketmaster event id. The events
    // twin of venues: not private, so reads are open to everyone; signed-in writes
    // for v1. Both partners read the SAME event docs (keyed by the shared deck),
    // which is what makes two-player event matching line up.
    //
    // DATE-TTL: each doc carries `expireAt` (= the event's start + grace). Enable
    // a Firestore native TTL policy on `events.expireAt` (console → Firestore →
    // TTL) so past events auto-delete with zero maintenance. EventCache also
    // filters past events at read time, so correctness never depends on the sweep.
    //
    // PRE-LAUNCH HARDENING: "any signed-in user can write" means a client could
    // poison the cache. Same end-state as venues — `allow write: if false` and do
    // cache writes from a Cloud Function (Admin SDK bypasses rules). Accepted for v1.
    match /events/{eventId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ---------- eventQueries/{queryKey} ----------
    // Pointer cache: a location bucket + date window -> an ordered list of event
    // ids (the curated deck), so repeat lookups skip the rate-limited Discovery
    // search. Same posture as venueQueries: world-readable, signed-in writes for
    // v1, Cloud-Function-only later.
    match /eventQueries/{queryKey} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Anything not matched above is denied by default.
  }
}
