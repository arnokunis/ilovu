rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    // Is there a signed-in user at all?
    function isSignedIn() {
      return request.auth != null;
    }

    // The signed-in user's uid.
    function uid() {
      return request.auth.uid;
    }

    // Is the signed-in user one of the two members of this couple? Reads the
    // parent couple doc, so it costs one document read per evaluated write —
    // acceptable for v1. Used to scope the swipes/matches subcollections.
    function isCoupleMember(coupleId) {
      return isSignedIn()
             && uid() in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
    }

    // ---------- users/{userId} ----------
    // A user's private profile/state. Owner-only, full stop.
    match /users/{userId} {
      allow read, write: if isSignedIn() && uid() == userId;
    }

    // ---------- invites/{token} ----------
    // The doc ID is an unguessable token. Two actors touch it:
    //   * the creator (full control of their own invite)
    //   * a redeemer (any other signed-in user who knows the token)
    match /invites/{token} {

      // CREATE: only the signed-in user can create an invite, and only one
      // stamped with themselves as creator, starting life as a fresh,
      // unconsumed invite. This stops anyone forging an invite "from" someone
      // else or pre-marking it consumed.
      allow create: if isSignedIn()
                    && request.resource.data.creatorId == uid()
                    && request.resource.data.status == 'pending'
                    && request.resource.data.consumedBy == null;

      // READ: creator-only (2026-07-18). Redemption is CF-only (Admin SDK
      // bypasses rules), so no other client ever needs to read an invite —
      // the old "any signed-in user may read to redeem" grant was a leftover
      // from the client-redeem era. Tightening this matters now that codes
      // are 5 chars: it closes direct-read enumeration, leaving `redeemInvite`
      // (rate-limited, expiring) as the ONLY guessing surface.
      allow read: if isSignedIn() && resource.data.creatorId == uid();

      // DELETE: only the creator can tear down their own invite (e.g. revoke).
      allow delete: if isSignedIn() && resource.data.creatorId == uid();

      // UPDATE (redeem): Cloud-Function-only. Consuming an invite happens
      // inside the `redeemInvite` transaction (Admin SDK bypasses rules),
      // atomically with couple creation — so a client can't consume an invite on
      // its own and the consume+create pair can't half-complete or be raced.
      // ONE narrow client carve-out (2026-07-19): the CREATOR may attach/refresh
      // their own FCM token on their own still-pending invite — nothing else —
      // so `redeemInvite` can push "you're connected 💕" the moment the partner
      // joins (permission is granted at the pairing moment, AFTER creation, so
      // the token often arrives late and needs this update path).
      allow update: if isSignedIn()
                    && resource.data.creatorId == uid()
                    && resource.data.status == 'pending'
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['creatorFcmToken'])
                    && request.resource.data.creatorFcmToken is string;
    }

    // ---------- couples/{coupleId} ----------
    // Links exactly two users. `members` is a 2-element list of their uids.
    match /couples/{coupleId} {

      // READ: only the two people in `members` can see the couple doc.
      allow read: if isSignedIn() && uid() in resource.data.members;

      // CREATE: Cloud-Function-only now. The couple doc is created inside the
      // `redeemInvite` transaction (Admin SDK), atomically with consuming the
      // invite — so a client can't forge a couple and redemption is all-or-nothing.
      // (Previously a redeemer created this doc directly at redemption time.)
      allow create: if false;

      // UPDATE: only an existing member may write, and the membership list is
      // frozen — you can update couple state, but you can't add/remove/swap
      // who's in the relationship.
      //
      // PRE-LAUNCH HARDENING: this permits a member to write ANY non-members
      // field, including the subscription flag (isPremium / subscriptionOwner) —
      // so a member could grant the couple premium without actually paying. Same
      // trusted-partner posture as matches/missions/memories, accepted for v1.
      // The clean end-state is a RevenueCat webhook -> Cloud Function (Admin SDK)
      // as the ONLY writer of the subscription fields, with these rules rejecting
      // client writes to them. See SubscriptionService for the matching note.
      allow update: if isSignedIn()
                    && uid() in resource.data.members
                    && request.resource.data.members == resource.data.members;

      // DELETE: not allowed from the client. Leave couples to be torn down by
      // a trusted server/admin path if ever needed.
      allow delete: if false;
    }

    // ---------- couples/{coupleId}/swipes/{cardId} ----------
    // Shared like record for two-player matching. Only RIGHT-swipes are stored;
    // `likedBy` holds the uids who liked this card. Both members present => match.
    // Scoped to the couple's two members, and a member may only add THEIR OWN uid
    // to likedBy — they can't stamp the partner or remove an existing like.
    match /couples/{coupleId}/swipes/{cardId} {
      allow read: if isCoupleMember(coupleId);

      // CREATE: the first liker writes a doc whose likedBy is exactly [self].
      allow create: if isCoupleMember(coupleId)
                    && request.resource.data.likedBy.hasOnly([uid()])
                    && request.resource.data.likedBy.hasAll([uid()]);

      // UPDATE: the second liker may only ADD self — no removals (hasAll(old)),
      // no foreign additions (hasOnly(old + self)), and self must end up present.
      allow update: if isCoupleMember(coupleId)
                    && request.resource.data.likedBy.hasAll(resource.data.likedBy)
                    && request.resource.data.likedBy.hasOnly(resource.data.likedBy.concat([uid()]))
                    && request.resource.data.likedBy.hasAll([uid()]);

      allow delete: if false;
    }

    // ---------- couples/{coupleId}/matches/{cardId} ----------
    // Created when both members have liked a card. id-only (cardId + deck); the
    // client rebuilds the card from local sample data. Immutable once made.
    //
    // PRE-LAUNCH HARDENING: a member could in principle create a match doc whose
    // pair isn't truly mutual (the rules don't cross-check the swipes doc here).
    // Trusted-partner risk, accepted for v1; the clean end-state is to create
    // matches only from a Cloud Function that verifies both likes — same
    // trajectory as the invite-redemption and venue-cache hardening notes.
    match /couples/{coupleId}/matches/{cardId} {
      allow read:   if isCoupleMember(coupleId);
      // CREATE: a member may create the match, and `createdBy` MUST be their own
      // uid. The Stage 5 nudge targets the partner who ISN'T createdBy, so binding
      // createdBy to the caller makes that targeting forge-proof — a member can't
      // stamp the partner as the completer to misdirect (or self-trigger) a nudge.
      allow create: if isCoupleMember(coupleId)
                    && request.resource.data.createdBy == uid();
      allow update, delete: if false;
    }

    // ---------- couples/{coupleId}/missions/{cardId} ----------
    // The shared, syncable planning state for a matched date (status, scheduled
    // date, budget, checklist). Doc id == cardId so both partners' apps write the
    // same document — that's what makes a date/time edit on one phone reach the
    // other. Either member may create OR update it (planning is collaborative;
    // last write wins for v1). Scoped to the couple's two members.
    //
    // PRE-LAUNCH HARDENING: same trust posture as matches — a member could write
    // arbitrary fields here. Field-shape validation (and, if ever needed, a
    // server-authored write path) is deferred, consistent with the matches /
    // invite-redemption / venue-cache notes above.
    // Either member may DELETE a mission (remove a planned date off both
    // dashboards) — same removable posture as the bucketList; unlike memories,
    // which are precious and stay delete-locked. Scoped to the couple's members.
    match /couples/{coupleId}/missions/{cardId} {
      allow read:           if isCoupleMember(coupleId);
      allow create, update: if isCoupleMember(coupleId);
      allow delete:         if isCoupleMember(coupleId);
    }

    // ---------- couples/{coupleId}/memories/{memoryId} ----------
    // The shared Memory Vault metadata: the proof-photo's Storage path plus
    // title/emoji/date/rating/note. Doc id == the memory's UUID. The photo BYTES
    // live in Cloud Storage (see storage.rules), never here. Either member may
    // create/update (the couple shares one vault). Scoped to the two members.
    //
    // PRE-LAUNCH HARDENING: same trust posture as missions/matches — a member
    // could write arbitrary fields. Field-shape validation (and a server-
    // authored write path, if ever needed) is deferred, consistent with the
    // notes above and with storage.rules' couple-membership note.
    match /couples/{coupleId}/memories/{memoryId} {
      allow read:           if isCoupleMember(coupleId);
      allow create, update: if isCoupleMember(coupleId);
      allow delete:         if false;
    }

    // ---------- couples/{coupleId}/bucketList/{itemId} ----------
    // The shared date wishlist: custom date ideas the couple adds themselves. Doc
    // id == the item's UUID. Either member may create/update AND delete (unlike
    // missions/memories, wishlist items are meant to be removed). Scoped to the
    // couple's two members. Same trust posture as missions/memories — a member
    // could write arbitrary fields; field-shape validation is deferred.
    match /couples/{coupleId}/bucketList/{itemId} {
      allow read, create, update, delete: if isCoupleMember(coupleId);
    }

    // ---------- couples/{coupleId}/dailyAnswers/{dateKey} ----------
    // One doc per calendar day for the shared Daily Question. `answers` is a
    // uid-keyed map (uid -> answer text); doc id is the local-date key. Scoped to
    // the couple's two members, and a member may only write THEIR OWN answer key —
    // never overwrite the partner's — the map twin of the swipes "add only your
    // own uid" rule. This is what guarantees the "answer to unlock" reveal can't
    // be gamed by writing/reading on the partner's behalf.
    //
    // PRE-LAUNCH HARDENING: as with swipes/matches, this is client-enforced and a
    // member could still write a wrong `question`/`dateKey` (trusted-partner, low
    // risk). Note too that both members can READ the doc, so the partner's answer
    // reaches the device before the local "answer to unlock" gate lifts — strict
    // server-side withholding would need a Cloud Function, deferred on the same
    // trajectory as the other hardening notes.
    match /couples/{coupleId}/dailyAnswers/{dateKey} {
      allow read: if isCoupleMember(coupleId);

      // CREATE: the first answerer writes a doc whose answers map has ONLY their
      // own uid key.
      allow create: if isCoupleMember(coupleId)
                    && request.resource.data.answers.keys().hasOnly([uid()]);

      // UPDATE: the second answerer may only ADD/CHANGE their own answers key —
      // the diff of the answers map must affect no key but their own (so the
      // partner's answer can't be edited or removed).
      allow update: if isCoupleMember(coupleId)
                    && request.resource.data.answers.diff(resource.data.answers).affectedKeys().hasOnly([uid()]);

      allow delete: if false;
    }

    // ---------- couples/{coupleId}/games/{dateKey} ----------
    // One doc per day for the "Would You Rather" game. `choices` is a uid-keyed map
    // (uid -> "A" | "B"); doc id is the local-date key. Exact same own-key-only
    // shape as dailyAnswers — each member may only write/change THEIR OWN choice,
    // so the "did we match" reveal can't be gamed by writing on the partner's
    // behalf. Client-enforced trust posture as elsewhere (a member could still
    // write a wrong promptIndex — trusted-partner, low risk).
    match /couples/{coupleId}/games/{dateKey} {
      allow read: if isCoupleMember(coupleId);
      allow create: if isCoupleMember(coupleId)
                    && request.resource.data.choices.keys().hasOnly([uid()]);
      allow update: if isCoupleMember(coupleId)
                    && request.resource.data.choices.diff(resource.data.choices).affectedKeys().hasOnly([uid()]);
      allow delete: if false;
    }

    // ---------- venues/{placeId} ----------
    // Cached Google Places data, keyed by the resolved place.id. Venues aren't
    // private, so reads are open to everyone (even unauthenticated).
    //
    // HARDENED: writes are Cloud-Function-only (the `cacheWrite` callable, Admin SDK
    // bypasses rules) — a signed-in client can no longer poison the cache or write
    // huge docs straight into it. The app still fetches Places on-device and hands
    // the resolved doc to cacheWrite to persist (thin gate; moving the fetch itself
    // server-side is the post-launch fast-follow).
    match /venues/{placeId} {
      allow read: if true;
      allow write: if false;
    }

    // ---------- venueQueries/{queryKey} ----------
    // Pointer cache: a normalized free-text query + location bucket -> placeId,
    // so repeat lookups skip the billed Text Search. World-readable; writes are
    // Cloud-Function-only via cacheWrite (same as venues).
    match /venueQueries/{queryKey} {
      allow read: if true;
      allow write: if false;
    }

    // ---------- events/{eventId} ----------
    // Cached Ticketmaster events, keyed by the Ticketmaster event id. The events
    // twin of venues: not private, so reads are open to everyone; signed-in writes
    // for v1. Both partners read the SAME event docs (keyed by the shared deck),
    // which is what makes two-player event matching line up.
    //
    // DATE-TTL: each doc carries `expireAt` (= the event's start + grace). Enable
    // a Firestore native TTL policy on `events.expireAt` (console → Firestore →
    // TTL) so past events auto-delete with zero maintenance. EventCache also
    // filters past events at read time, so correctness never depends on the sweep.
    //
    // PRE-LAUNCH HARDENING: "any signed-in user can write" means a client could
    // poison the cache. Same end-state as venues — `allow write: if false` and do
    // cache writes from a Cloud Function (Admin SDK bypasses rules). Accepted for v1.
    match /events/{eventId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ---------- eventQueries/{queryKey} ----------
    // Pointer cache: a location bucket + date window -> an ordered list of event
    // ids (the curated deck), so repeat lookups skip the rate-limited Discovery
    // search. World-readable; writes are Cloud-Function-only via cacheWrite (same
    // as venueQueries). NOTE: events/{eventId} above is still signed-in-writable —
    // it's the one deferred cache collection (dormant + concrete expireAt Timestamp
    // that doesn't fit the JSON-only cacheWrite relay); gate it when events revives.
    match /eventQueries/{queryKey} {
      allow read: if true;
      allow write: if false;
    }

    // ---------- placeDeckQueries/{queryKey} ----------
    // Pointer cache for the Near You PLACES deck: a location bucket -> an ordered
    // list of curated placeIds (the deck). The resolved venues themselves live in
    // venues/{placeId} (ruled above). World-readable; writes are Cloud-Function-only
    // via cacheWrite (same as venueQueries/eventQueries).
    match /placeDeckQueries/{queryKey} {
      allow read: if true;
      allow write: if false;
    }

    // Anything not matched above is denied by default.
  }
}
