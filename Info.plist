<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Partial Info.plist. GENERATE_INFOPLIST_FILE stays YES, so Xcode merges
	     the generated keys and all INFOPLIST_KEY_* build settings (usage
	     descriptions, scene manifest, etc.) on top of what's declared here.
	     This file adds keys the build settings can't reliably express:
	       * the custom URL scheme for invite deep links (ilovu://invite/<token>)
	       * NSCalendarsWriteOnlyAccessUsageDescription — its INFOPLIST_KEY_ form
	         is silently dropped by Xcode 16's plist generator (the location key
	         works, this one doesn't), so it must live in a real plist or the
	         app crashes the moment it requests calendar access.
	     NOTE: Xcode's Signing & Capabilities editor REWRITES this file when you
	     add a capability and will strip both this comment and the calendar key
	     (it did exactly that adding Push/Background Modes). If you edit
	     capabilities in the GUI, re-check that the calendar key survived. -->
	<!-- No non-exempt encryption: iLovu only uses standard HTTPS/TLS. Declared
	     here (not as INFOPLIST_KEY_) so it reliably lands in the built binary and
	     App Store Connect skips the export-compliance prompt on each upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>iLovu adds your planned dates and event matches to your calendar so you both remember when they are.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.ilovu.app.iLovu.invite</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>ilovu</string>
			</array>
		</dict>
	</array>
	<!-- SKAdNetwork — install attribution for the networks that will ADVERTISE this
	     app. Added 2026-09-07, deliberately WITHOUT any SDK: SKAdNetwork postbacks
	     go from Apple directly to the ad network, so an advertised app only has to
	     declare the network's id here. No Facebook SDK, no ATT prompt, no privacy
	     nutrition-label change is required for install-level attribution.
	     (An SDK is only needed for post-install CONVERSION VALUES and user-level
	     attribution — deliberately deferred until paid conversion is proven.)

	     ONLY the networks that will run our campaigns belong here. This is NOT the
	     long AdMob mediation list: that list is for apps which SHOW ads, and iLovu
	     shows none. Apple Search Ads is absent on purpose — ASA attributes through
	     Apple's own AdServices/AdAttributionKit, not SKAdNetwork, so it needs no id.
	     Re-verify these against the networks' own docs before trusting them; the
	     lists do change. Fetched 2026-09-07 from developers.facebook.com/docs/SKAdNetwork
	     and developers.google.com. -->
	<key>SKAdNetworkItems</key>
	<array>
		<!-- Meta / Facebook -->
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>v9wttpbfk9.skadnetwork</string>
		</dict>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>n38lu8286q.skadnetwork</string>
		</dict>
		<!-- Google Ads -->
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>cstr6suwn9.skadnetwork</string>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
