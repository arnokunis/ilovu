rules_version = '2';

// iLovu Cloud Storage — couple-scoped photos.
//   couples/{coupleId}/profile.jpg              the shared couple photo (one per couple)
//   couples/{coupleId}/memories/{memoryId}.jpg  proof photos (Memory Vault — slice 2)
//
// =====================================================================
// COUPLE-MEMBERSHIP ENFORCEMENT (hardened):
//
//   Storage Security Rules CANNOT read Firestore, so membership is bound to
//   the auth TOKEN instead: the redeemInvite Cloud Function (and the one-off
//   backfill) stamps a custom `coupleId` claim on both members at pairing, and
//   the match below requires request.auth.token.coupleId == coupleId. A
//   signed-in user who merely knows/guesses a coupleId can no longer read,
//   write, or delete that couple's photos — their token doesn't carry the claim.
//   (The client force-refreshes its ID token on redeem + couple-resolve so the
//   claim is present; see CoupleService.refreshAuthClaims.)
//
//   REMAINING (#4b): enable Firebase App Check enforcement on Storage.
// =====================================================================

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Incoming upload must be an image under 5 MB. (request.resource is the
    // pending upload; it's null on read/delete, so guard those separately.)
    function isValidImageUpload() {
      return request.resource.size < 5 * 1024 * 1024
             && request.resource.contentType.matches('image/.*');
    }

    // Couple membership, bound to the auth token's custom `coupleId` claim
    // (Storage rules can't read Firestore — see the header note). Only the two
    // members, whose token carries this coupleId, pass.
    function isCoupleMember(coupleId) {
      return isSignedIn() && request.auth.token.coupleId == coupleId;
    }

    // All couple photos live under couples/{coupleId}/**. Scoped to the two
    // members via the coupleId claim.
    match /couples/{coupleId}/{allPaths=**} {
      allow read:   if isCoupleMember(coupleId);
      allow write:  if isCoupleMember(coupleId) && isValidImageUpload();
      allow delete: if isCoupleMember(coupleId);
    }

    // Everything else is locked down.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
